include CONTRIBUTING.md
include CODE_OF_CONDUCT.md SECURITY.md SUPPORT.md
include Makefile package.json package-lock.json .nvmrc uv.lock .tool-versions
include .github/release-please-config.json .github/.release-please-manifest.json
